{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "0b98bbb5104673c59afa135796b1c247",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/f/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "seedbox-files" }],
  // Keeps copies moving while the app is closed.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
